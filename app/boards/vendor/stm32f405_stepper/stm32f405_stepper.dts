/dts-v1/;
#include <st/f4/stm32f405Xg.dtsi>
#include <st/f4/stm32f405rgtx-pinctrl.dtsi>
#include "stm32f405_stepper.dtsi"


/ {
	model = "STM32F405 stepper";
	compatible = "st,stm32f405";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &ccm0;
	};

	leds {
		compatible = "gpio-leds";

		led: led {
			gpios = <&gpioc 14 GPIO_ACTIVE_HIGH>;
			label = "User LED";
		};
		//     as5047p_cs: as5047p_cs {
			//         gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
			//         label = "AS5047P_CS";
		//     };
	};

	// /* Define the Index Pin as a GPIO for Interrupt use */
	// encoder_index: encoder_index {
		//     compatible = "gpio-keys";
		//     index_pin: index_pin {
			//         gpios = <&gpioa 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			//         label = "Encoder Index";
		//     };
	// };
	trigger_signal {
		compatible = "gpio-keys";
		meas_trigger: meas_trigger {
			gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
			label = "Measurement Trigger";
		};
	};

	//    pwm_leds {
		//        compatible = "pwm-leds";
		//        pwm_led0: led_pwm_0 {
			//            pwms = <&pwm2 3 PWM_MSEC(1000) PWM_POLARITY_INVERTED>; // pwmtimer channel_number pwmperiod polarity
			//            label = "Blue PWM LED";
		//        };
	//    };

	drv8424_motor_ctrl: drv8424_motor_ctrl {
		compatible = "pwm-leds";
		status = "okay";
		/* PC8 - Timer 8 Channel 3 */
		drv_step: drv_step {
			pwms = <&pwm8 3 PWM_USEC(100) PWM_POLARITY_NORMAL>;
			label = "DRV8424_STEP";
		};
	};

	drv8424_signals {
		compatible = "gpio-keys";
		drv_sleep: drv_sleep {
			gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
			label = "DRV8424_SLEEP";
		};
		drv_fault: drv_fault {
			gpios = <&gpiob 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "DRV8424_FAULT";
		};
		drv_enable: drv_enable {
			gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
			label = "DRV8424_ENABLE";
		};

		drv_dir: drv_dir {
			gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
			label = "DRV8424_DIR";
		};

		drv_mode1: drv_mode1 {
			gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>;
			label = "DRV8424_M1";
		};

		/* M0 is on a DAC pin (usually PA4 or PA5 on F405) */
		/* Replace 'gpioa 4' with the actual pin used if different */
		drv_mode0: drv_mode0 {
			gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
			label = "DRV8424_M0";
		};
	};

	aliases {
		led0 = &led;
	};
};

&clk_lsi {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(16)>;
	status = "okay";
};

&pll {
	div-m = <8>;
	mul-n = <168>;
	div-p = <2>;
	div-q = <7>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(168)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <2>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
};

//&spi1_nss_pa15 {
	//    slew-rate = "very-high-speed";
//};

//&spi1 {
	//    status = "okay";
	//    pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	//    pinctrl-names = "default";
	//    // cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>; CS was not toggled
	//    // keep this for later testing if i want to make a driver package for the this sensor else delete it at the end.
	//    // as5047p@0 {
		//        //     status = "okay";
		//        //     compatible = "ams,as5047p";
		//        //     reg = <0>;
		//        //     spi-max-frequency = <10000000>;
	//    // };
//};
//
//&spi2 {
	//    pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	//    pinctrl-names = "default";
	//    status = "okay";
//};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB1, 28)>,
			 <&rcc STM32_SRC_LSI RTC_SEL(2)>;
	status = "okay";
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};


&pinctrl {
	tim8_ch3_pc8: tim8_ch3_pc8 {
		pinmux = <STM32_PINMUX('C', 8, AF3)>;
		drive-push-pull;
	};
};

&timers8 {
	status = "okay";
	st,prescaler = <64>; /* Divide the timer clock by 4 or higher */
	pwm8: pwm {
		status = "okay";
		pinctrl-0 = <&tim8_ch3_pc8>;
		pinctrl-names = "default";
	};
};


&dac1 {
	status = "okay";
	pinctrl-0 = <&dac_out2_pa5>;
	pinctrl-names = "default";
};

&pinctrl {
	dac_out2_pa5: dac_out2_pa5 {
		pinmux = <STM32_PINMUX('A', 5, ANALOG)>;
	};
};


&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
